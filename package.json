{
  "name": "rubik-fix",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "npm run build:js && npm run build:css && npm run dist",
    "build:js": "esbuild assets/app.js --minify --outfile=assets/app.min.js && esbuild assets/portfolio.module.js --minify --format=esm --outfile=assets/portfolio.module.min.js",
    "build:css": "lightningcss --minify assets/styles.css -o assets/styles.min.css",
    "dist": "mkdir -p dist/assets && cp index.html 404.html aviso-legal.html politica-privacidad.html sitemap.xml robots.txt dist/ && cp assets/*.min.* dist/assets/",
    "lint": "eslint assets/app.js && prettier --check assets/*.css index.html || true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Juanmaes83/rubiksotamovil.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Juanmaes83/rubiksotamovil/issues"
  },
  "homepage": "https://github.com/Juanmaes83/rubiksotamovil#readme",
  "devDependencies": {
    "esbuild": "^0.28.0",
    "lightningcss-cli": "^1.32.0"
  },
  "private": true
}